+.folded-photo img{position:absolute;width:337%;max-width:none;height:auto;left:-234%;top:-6%}
+.management-tag{display:none;position:absolute;left:12px;right:12px;bottom:14px;text-align:center;padding:10px;background:#d8ef91;color:#2a422b;font:700 9px var(--mono);border:1px solid #586a3c;transform:rotate(-4deg)}
+.art-mode .stickers{left:-25px;right:auto;top:56%;bottom:auto;display:flex;flex-direction:column;align-items:flex-start;gap:6px}
+.art-mode .sticker{position:static!important;display:none;padding:6px 9px;border:1px solid #9cb47d88;border-radius:4px;background:#18352be8;font-size:8px;flex-direction:row}
+.art-mode .sticker.on{display:flex}
+.art-mode .sticker:after{display:none}
+.art-mode .sticker em{width:15px;height:15px;font-size:7px}
+.art-mode .screw{left:auto;right:12px;top:12px;z-index:3}
+.art-mode .idbadge{left:12px;top:12px;z-index:3}
+.art-mode .bubble:before{content:'ORCHARD / OPEN MIC'}
+.art-mode .idbadge.on~.robot-portrait .photo-moustache{opacity:1}
+.photo-moustache{position:absolute;left:55%;top:12%;width:22px;height:7px;border-radius:40% 40% 60% 60%;background:#19241c;opacity:0;transform:rotate(16deg)}
+.photo-moustache:after{content:'';position:absolute;left:16px;width:22px;height:7px;border-radius:40% 40% 60% 60%;background:#19241c;transform:rotate(-32deg)}
+.robot-portrait.replacement .photo-moustache{opacity:1}
+.scene[data-stage="3"] .unit-photo{filter:saturate(.75)}
+.scene[data-stage="5"] .unit-photo{filter:saturate(.5) contrast(1.08)}
+.scene[data-ending="quit"] .robot-portrait{filter:grayscale(1);transform:rotate(-5deg) translateY(10px)}
+.scene[data-ending="outsource"] .robot-portrait{transform:translateX(-15px) rotate(-2deg)}
+.scene[data-ending="boss"] .management-tag{display:block}
+.scene[data-ending="unavailable"] .unit-photo{visibility:hidden}
+.scene[data-ending="unavailable"] .folded-photo{display:block}
+.art-mode .mug{object-fit:cover;object-position:50% 0;border-radius:5px}
+.art-mode .stage:before{display:none}
+@media(max-width:1100px) and (min-width:801px){
+ .art-mode main{grid-template-columns:1fr}
+ .art-mode .scene{min-height:740px}
+ .art-mode .bot-wrap{width:330px;right:30px;height:550px}
+}
 @media(max-width:800px){
- header{padding:14px 16px 10px}.meters{gap:12px;font-size:10px}
- main{padding:0 12px 28px;gap:14px}
- .scene{height:auto;display:flex;flex-direction:column;padding:28px 22px 0}
- .intro,.bubble,.stage,.titleblock{position:relative;left:auto;right:auto;top:auto;bottom:auto}
- .intro h2{font-size:52px}
- .inspection-stamp,.stickers{display:none}
- .bubble{width:auto;margin-top:22px}
- .bubble:after{left:44%;right:auto;top:auto;bottom:-9px;transform:rotate(135deg)}
- .stage{height:330px;margin-top:6px}
- .bot-wrap{left:50%;right:auto;margin-left:-130px;scale:.82;transform-origin:50% 100%}
- .titleblock{margin:0 -12px 0;grid-template-columns:1fr 1fr}
- .titleblock span:nth-child(2){border-right:0}
- .titleblock span:last-child{grid-column:1/-1;text-align:left;border-top:1px solid var(--rule)}
- .panel{padding:20px}
+ .art-mode .bot-wrap{width:190px;height:325px;right:18px;transform:none;scale:1}
+ .portrait-photo{height:285px}
+ .robot-portrait figcaption{height:40px;padding:8px;font-size:8px}
+ .robot-portrait figcaption small{font-size:6px}
+ .robot-portrait figcaption b{display:none}
+ .art-mode .stickers{display:none}
+ .art-mode .bubble{width:143px;left:18px}
+ .art-mode .intro>p:not(.kicker){max-width:300px}
+ .management-tag{font-size:7px;padding:6px;left:6px;right:6px}
+ .photo-moustache{scale:.6;transform-origin:left center}
 }
-@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
+@media(max-width:360px){
+ .art-mode .bot-wrap{width:165px;height:287px;right:12px}
+ .art-mode .portrait-photo{height:247px}
+ .art-mode .bubble{width:126px;left:14px}
+}
+@media(prefers-reduced-motion:reduce){.robot-portrait,.unit-photo{transition:none}}
+
+@media(max-width:800px){.art-mode .scene{height:700px}}
